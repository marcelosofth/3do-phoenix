-RETRO_API void retro_set_controller_port_device(unsigned port, unsigned device) { (void)port; (void)device; }
+RETRO_API void retro_set_controller_port_device(unsigned port, unsigned device) {
+    if (port >= 2) return;
+    g_port_dev[port] = (device == RETRO_DEVICE_NONE) ? RETRO_DEVICE_NONE : RETRO_DEVICE_JOYPAD;
+    if (g_have_machine) apply_port_devices();
+    set_input_descriptors();
+}
 
